---
export interface Props {
  href?: string;
  title: string;
  body?: string;
  hint?: string;
  tags?: string[];
  index?: number;
}

const { href = '', title, body = '', hint = '', tags = [], index } = Astro.props as Props;
const isLink = Boolean(href);
const isExternal = isLink && !href.startsWith('mailto:');

/* An <a> with no href has no link semantics anyway, so unlinked cards render
   as a plain container rather than an anchor screen readers ignore. */
const Face = isLink ? 'a' : 'div';
---

<li class="card reveal">
  <Face
    href={isLink ? href : undefined}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class:list={['card-face', 'clickable-surface', { disabled: !isLink }]}
    data-tilt="5"
  >
    {index !== undefined && <span class="card-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>}

    <div class="card-top">
      <h3>{title}</h3>
      {
        isLink ? (
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M3.5 12.5 12.5 3.5M6 3.5h6.5V10" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        ) : (
          <span class="badge" aria-hidden="true">
            private
          </span>
        )
      }
    </div>

    {body && <p>{body}</p>}

    {
      tags.length > 0 && (
        <ul class="tags" role="list">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    {hint && <small>{hint}</small>}

    <span class="card-scan" aria-hidden="true"></span>
  </Face>
</li>

<style>
  .card {
    list-style: none;
    display: flex;
    padding: 0;
    perspective: 900px;
  }

  /* Perspective comes from `.card`, so the tilt only needs the rotations. */
  .card-face {
    position: relative;
    display: block;
    width: 100%;
    padding: 1.25rem 1.3rem;
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.5;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translate3d(0, var(--lift, 0px), 0);
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .card-face.disabled {
    cursor: default;
  }

  .card-face:is(:hover, :focus-visible) {
    --lift: -3px;
    box-shadow:
      0 22px 55px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(61, 255, 122, 0.18);
  }

  /* Bottom-right keeps the numeral clear of the arrow and the badge, which
     both sit in the top-right corner. */
  .card-index {
    position: absolute;
    right: 1.1rem;
    bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(61, 255, 122, 0.06);
    letter-spacing: -0.06em;
    pointer-events: none;
    transition:
      color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .card-face:is(:hover, :focus-visible) .card-index {
    color: rgba(61, 255, 122, 0.14);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.35s var(--ease-out);
  }

  .card-face:is(:hover, :focus-visible) h3 {
    color: var(--color-primary);
  }

  .arrow {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-primary);
    transition:
      transform 0.4s var(--ease-spring),
      background 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .card-face:is(:hover, :focus-visible) .arrow {
    transform: translate3d(3px, -3px, 0);
    background: rgba(61, 255, 122, 0.12);
    border-color: var(--color-border-strong);
  }

  .badge {
    flex-shrink: 0;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  p {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.22rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: var(--color-hint);
    transition: border-color 0.3s var(--ease-out);
  }

  .card-face:is(:hover, :focus-visible) .tags li {
    border-color: rgba(61, 255, 122, 0.24);
  }

  small {
    display: block;
    margin-top: 0.9rem;
    /* Leaves room for the numeral now sharing this row */
    padding-right: 2.75rem;
    color: var(--color-hint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.85;
  }

  /* Thin line that scans down the card on hover. Drawn as a 1px-tall
     background on a full-height layer so the travel distance follows the
     card without needing a measured pixel value. */
  .card-scan {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: 0 0;
    opacity: 0;
    pointer-events: none;
  }

  .card-face:is(:hover, :focus-visible) .card-scan {
    animation: card-scan 1.1s var(--ease-out);
  }

  @keyframes card-scan {
    0% {
      opacity: 0;
      background-position: 0 0;
    }
    25% {
      opacity: 0.75;
    }
    100% {
      opacity: 0;
      background-position: 0 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-face {
      transform: none;
    }

    .card-scan {
      display: none;
    }
  }
</style>
