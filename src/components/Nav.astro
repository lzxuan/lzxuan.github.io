---
const links = [
  { href: '#about', label: 'About' },
  { href: '#stack', label: 'Stack' },
  { href: '#projects', label: 'Work' },
];
---

<nav class="site-nav" aria-label="Primary navigation">
  <a class="nav-mark" href="#top" aria-label="Back to top">
    <span class="nav-mark-text">ZX</span><span class="nav-mark-dot">.</span>
  </a>

  <div class="nav-links">
    <span class="nav-indicator" aria-hidden="true"></span>
    {links.map((link) => <a href={link.href} data-nav-link>{link.label}</a>)}
  </div>

  <a class="nav-status clickable-surface" href="#contact">
    <span class="pulse-dot" aria-hidden="true"></span>
    <span>Available</span>
  </a>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    z-index: 20;
    width: min(calc(100% - 2rem), 72rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.5rem 0.55rem 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.85rem;
    background: rgba(5, 8, 6, 0.6);
    box-shadow: 0 12px 50px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(18px) saturate(140%);
    opacity: 0;
    transform: translate3d(-50%, -18px, 0);
    animation: nav-in 0.8s 0.05s var(--ease-out) forwards;
    transition:
      background 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      padding 0.4s var(--ease-out);
  }

  /* Condenses once the hero is behind you */
  .site-nav.is-stuck {
    padding-block: 0.35rem;
    border-color: rgba(61, 255, 122, 0.16);
    background: rgba(5, 8, 6, 0.82);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
  }

  @keyframes nav-in {
    to {
      opacity: 1;
      transform: translate3d(-50%, 0, 0);
    }
  }

  .nav-mark {
    width: max-content;
    display: inline-flex;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.04em;
  }

  .nav-mark-text {
    background-image: linear-gradient(90deg, var(--color-text) 50%, var(--color-primary) 50%);
    background-size: 200% 100%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: background-position 0.45s var(--ease-out);
  }

  .nav-mark:hover .nav-mark-text {
    background-position: -100% 0;
  }

  .nav-mark-dot {
    color: var(--color-primary);
    animation: blink 1.4s step-end infinite;
  }

  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-links a {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 0.5rem;
    transition: color 0.3s var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    color: var(--color-primary);
  }

  /* Pill that slides between links; position is set from script */
  .nav-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 0;
    height: 1.85rem;
    width: var(--nav-w, 0px);
    border-radius: 0.5rem;
    background: rgba(61, 255, 122, 0.1);
    border: 1px solid rgba(61, 255, 122, 0.22);
    opacity: var(--nav-o, 0);
    transform: translate3d(var(--nav-x, 0px), -50%, 0);
    transition:
      transform 0.45s var(--ease-spring),
      width 0.45s var(--ease-spring),
      opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  .nav-status {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }

  @media (max-width: 620px) {
    .site-nav {
      grid-template-columns: auto 1fr auto;
      padding-inline: 0.75rem 0.45rem;
    }

    .nav-links {
      justify-content: center;
    }

    .nav-links a {
      padding-inline: 0.5rem;
      font-size: 0.62rem;
    }

    .nav-status span:last-child {
      display: none;
    }

    .nav-status {
      padding: 0.6rem;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const indicator = document.querySelector<HTMLElement>('.nav-indicator');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  if (nav && indicator && navLinks.length) {
    const sections = navLinks
      .map((link) => document.querySelector<HTMLElement>(link.hash))
      .filter((section): section is HTMLElement => section !== null);

    const moveIndicator = (link: HTMLAnchorElement | null) => {
      if (!link) {
        indicator.style.setProperty('--nav-o', '0');
        return;
      }
      indicator.style.setProperty('--nav-x', `${link.offsetLeft}px`);
      indicator.style.setProperty('--nav-w', `${link.offsetWidth}px`);
      indicator.style.setProperty('--nav-o', '1');
    };

    const setActive = (id: string | null) => {
      let active: HTMLAnchorElement | null = null;
      for (const link of navLinks) {
        const match = link.hash === `#${id}`;
        link.classList.toggle('is-active', match);
        if (match) {
          link.setAttribute('aria-current', 'true');
          active = link;
        } else {
          link.removeAttribute('aria-current');
        }
      }
      moveIndicator(active);
    };

    /* Scroll spy: the section closest to the top third of the viewport wins. */
    let spyQueued = false;

    const runSpy = () => {
      spyQueued = false;
      nav.classList.toggle('is-stuck', window.scrollY > 80);

      const line = window.innerHeight * 0.35;
      let current: string | null = null;

      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= line && rect.bottom > line) {
          current = section.id;
          break;
        }
      }

      setActive(current);
    };

    const queueSpy = () => {
      if (spyQueued) return;
      spyQueued = true;
      requestAnimationFrame(runSpy);
    };

    runSpy();
    window.addEventListener('scroll', queueSpy, { passive: true });
    window.addEventListener('resize', queueSpy, { passive: true });
  }
</script>
